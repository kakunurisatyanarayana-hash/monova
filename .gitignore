# Build outputs and local caches (rebuilt automatically)
**/bin/
**/obj/
**/build/
**/.dart_tool/
**/.gradle/
**/.idea/
**/.vs/
**/.vscode/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.plugin_symlinks/
**/ephemeral/

# Logs and runtime data
**/logs/
*.log

# Secrets and local settings: never commit these
**/appsettings.Local.json
**/secrets.json
**/*.jks
**/*.keystore
**/key.properties
# Firebase app config downloaded from the Firebase console. Keep it out of the repository; see firebase/SETUP.md.
**/google-services.json
**/local.properties
**/.env

# OS and editor files
.DS_Store
Thumbs.db
